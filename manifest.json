{
  "name": "Xbox Purple Gaming Dashboard",
  "short_name": "XPGD",
  "description": "A complete Xbox-style gaming dashboard with purple theme, built as a static PWA",
  "start_url": "/index.html",
  "display": "standalone",
  "orientation": "landscape-primary",
  "background_color": "#0a0a0f",
  "theme_color": "#581c87",
  "scope": "/",
  "lang": "pt-BR",
  "dir": "ltr",
  "categories": ["games", "entertainment"],
  "icons": [
    {
      "src": "img/icons/icon-72.svg",
      "sizes": "72x72",
      "type": "image/svg+xml",
      "purpose": "any maskable"
    },
    {
      "src": "img/icons/icon-96.svg",
      "sizes": "96x96",
      "type": "image/svg+xml",
      "purpose": "any maskable"
    },
    {
      "src": "img/icons/icon-128.svg",
      "sizes": "128x128",
      "type": "image/svg+xml",
      "purpose": "any maskable"
    },
    {
      "src": "img/icons/icon-144.svg",
      "sizes": "144x144",
      "type": "image/svg+xml",
      "purpose": "any maskable"
    },
    {
      "src": "img/icons/icon-152.svg",
      "sizes": "152x152",
      "type": "image/svg+xml",
      "purpose": "any maskable"
    },
    {
      "src": "img/icons/icon-192.svg",
      "sizes": "192x192",
      "type": "image/svg+xml",
      "purpose": "any maskable"
    },
    {
      "src": "img/icons/icon-384.svg",
      "sizes": "384x384",
      "type": "image/svg+xml",
      "purpose": "any maskable"
    },
    {
      "src": "img/icons/icon-512.svg",
      "sizes": "512x512",
      "type": "image/svg+xml",
      "purpose": "any maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Library",
      "short_name": "Library",
      "description": "View your game library",
      "url": "/index.html#library",
      "icons": [{ "src": "img/icons/library.svg", "sizes": "192x192" }]
    },
    {
      "name": "Store",
      "short_name": "Store",
      "description": "Browse the game store",
      "url": "/index.html#store",
      "icons": [{ "src": "img/icons/store.svg", "sizes": "192x192" }]
    },
    {
      "name": "Profile",
      "short_name": "Profile",
      "description": "View your profile and achievements",
      "url": "/index.html#profile",
      "icons": [{ "src": "img/icons/profile.svg", "sizes": "192x192" }]
    }
  ],
  "screenshots": [
    {
      "src": "img/screenshots/home-wide.svg",
      "sizes": "1280x720",
      "type": "image/svg+xml",
      "form_factor": "wide",
      "label": "Home Dashboard"
    },
    {
      "src": "img/screenshots/library-wide.svg",
      "sizes": "1280x720",
      "type": "image/svg+xml",
      "form_factor": "wide",
      "label": "Game Library"
    },
    {
      "src": "img/screenshots/home-narrow.svg",
      "sizes": "720x1280",
      "type": "image/svg+xml",
      "form_factor": "narrow",
      "label": "Home Dashboard (Mobile)"
    }
  ],
  "related_applications": [],
  "prefer_related_applications": false,
  "edge_side_panel": {
    "preferred_width": 400
  },
  "launch_handler": {
    "client_mode": "focus-existing"
  },
  "protocol_handlers": [
    {
      "protocol": "web+xpgd",
      "url": "/index.html#%s"
    }
  ],
  "file_handlers": [
    {
      "action": "/index.html#game/%s",
      "accept": {
        "application/x-xpgd-game": [".xpgd"]
      }
    }
  ],
  "share_target": {
    "action": "/index.html#share",
    "method": "GET",
    "enctype": "application/x-www-form-urlencoded",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url"
    }
  }
}