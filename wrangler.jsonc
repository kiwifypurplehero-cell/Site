{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "site",
  "main": "worker.js",
  "compatibility_date": "2026-08-06",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*",
      "/emulators",
      "/emulators/",
      "/emulators/ps2",
      "/emulators/ps2/"
    ]
  },
  "ai": {
    "binding": "AI"
  },
  "r2_buckets": [
    {
      "binding": "GAME_ROMS",
      "bucket_name": "plumpgames-roms"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "plumpgames-auth",
      "database_id": "e80405a4-2ff2-4a0b-afba-7825856ba9f8",
      "migrations_dir": "migrations"
    }
  ]
}
