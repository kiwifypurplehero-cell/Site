{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "site",
  "main": "worker.js",
  "compatibility_date": "2026-08-06",
  "keep_vars": true,
  "triggers": {
    "crons": ["17 3 * * *"]
  },
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "html_handling": "none",
    "run_worker_first": [
      "/api/*",
      "/Emuladores", "/Emuladores/", "/Emuladores/PS1", "/Emuladores/PS1/", "/Emuladores/PS1/player",
      "/Emuladores/GBC", "/Emuladores/GBC/", "/Emuladores/GBC/player",
      "/Emuladores/GBA", "/Emuladores/GBA/", "/Emuladores/GBA/player",
      "/emulators", "/emulators/", "/emulators.html",
      "/gbc-player", "/gbc-player/", "/gbc-player.html",
      "/gba-player", "/gba-player/", "/gba-player.html",
      "/ps1-player", "/ps1-player/", "/ps1-player.html", "/play/ps1", "/play/ps1/"
    ]
  },
  "ai": {
    "binding": "AI"
  },
  "vars": {
    "B2_PS1_ENDPOINT": "https://s3.us-east-005.backblazeb2.com",
    "B2_PS1_BUCKET": "plumpgames-storage-ps1",
    "B2_PS1_PREFIX": "Jogos/",
    "B2_GBC_ENDPOINT": "https://s3.us-east-005.backblazeb2.com",
    "B2_GBC_BUCKET": "plumpgames-storage-ps1",
    "B2_GBC_PREFIX": "Jogos-GBC/",
    "B2_GBA_PREFIX": "Jogos-GBA/",
    "B2_ENDPOINT": "https://s3.us-east-005.backblazeb2.com",
    "B2_BUCKET": "plumpgames-storage-ps2",
    "B2_PS2_PREFIX": "ps2/jogos/"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "plumpgames-auth",
      "database_id": "e80405a4-2ff2-4a0b-afba-7825856ba9f8",
      "migrations_dir": "migrations"
    }
  ]
}
