{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "site",
  "main": "worker.js",
  "compatibility_date": "2026-08-06",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*",
      "/emulators",
      "/emulators/",
      "/emulators/ps1",
      "/emulators/ps1/",
      "/emulators/ps2",
      "/emulators/ps2/"
    ]
  },
  "ai": {
    "binding": "AI"
  },
  "vars": {
    "B2_PS1_ENDPOINT": "https://s3.us-east-005.backblazeb2.com",
    "B2_PS1_BUCKET": "plumpgames-storage-ps1",
    "B2_PS1_PREFIX": "Jogos/",
    "B2_ENDPOINT": "https://s3.us-east-005.backblazeb2.com",
    "B2_BUCKET": "plumpgames-storage-ps2",
    "B2_PS2_PREFIX": "ps2/jogos/"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "plumpgames-auth",
      "database_id": "e80405a4-2ff2-4a0b-afba-7825856ba9f8",
      "migrations_dir": "migrations"
    }
  ]
}
